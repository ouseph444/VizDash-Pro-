                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "isHidden": true
          },
          {
            "name": "New Customers (raw)",
            "dataType": "int64",
            "sourceColumn": "New Customers",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "isHidden": true
          }
        ],
        "measures": [
          {
            "name": "Revenue",
            "expression": "SUM('Marketing performance'[Revenue (raw)])",
            "formatString": "\"$\"#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "Marketing Spend",
            "expression": "SUM('Marketing performance'[Spend])",
            "formatString": "\"$\"#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "Gross Profit",
            "expression": "SUM('Marketing performance'[Revenue (raw)]) - SUM('Marketing performance'[Spend])",
            "formatString": "\"$\"#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "ROAS",
            "expression": "DIVIDE(SUM('Marketing performance'[Revenue (raw)]), SUM('Marketing performance'[Spend]))",
            "formatString": "#,0.00",
            "displayFolder": "Measures"
          },
          {
            "name": "ROI %",
            "expression": "DIVIDE((SUM('Marketing performance'[Revenue (raw)]) - SUM('Marketing performance'[Spend])), SUM('Marketing performance'[Spend]))",
            "formatString": "0.0%",
            "displayFolder": "Measures"
          },
          {
            "name": "Impressions",
            "expression": "SUM('Marketing performance'[Impressions (raw)])",
            "formatString": "#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "Clicks",
            "expression": "SUM('Marketing performance'[Clicks (raw)])",
            "formatString": "#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "Conversions",
            "expression": "SUM('Marketing performance'[Conversions (raw)])",
            "formatString": "#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "Leads",
            "expression": "SUM('Marketing performance'[Leads (raw)])",
            "formatString": "#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "New Customers",
            "expression": "SUM('Marketing performance'[New Customers (raw)])",
            "formatString": "#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "CTR",
            "expression": "DIVIDE(SUM('Marketing performance'[Clicks (raw)]), SUM('Marketing performance'[Impressions (raw)]))",
            "formatString": "0.00%",
            "displayFolder": "Measures"
          },
          {
            "name": "Conversion Rate",
            "expression": "DIVIDE(SUM('Marketing performance'[Conversions (raw)]), SUM('Marketing performance'[Clicks (raw)]))",
            "formatString": "0.00%",
            "displayFolder": "Measures"
          },
          {
            "name": "CPC",
            "expression": "DIVIDE(SUM('Marketing performance'[Spend]), SUM('Marketing performance'[Clicks (raw)]))",
            "formatString": "\"$\"#,0.00",
            "displayFolder": "Measures"
          },
          {
            "name": "CPM",
            "expression": "DIVIDE(SUM('Marketing performance'[Spend]), SUM('Marketing performance'[Impressions (raw)])) * 1000",
            "formatString": "\"$\"#,0.00",
            "displayFolder": "Measures"
          },
          {
            "name": "CPA",
            "expression": "DIVIDE(SUM('Marketing performance'[Spend]), SUM('Marketing performance'[Conversions (raw)]))",
            "formatString": "\"$\"#,0.00",
            "displayFolder": "Measures"
          },
          {
            "name": "CPL",
            "expression": "DIVIDE(SUM('Marketing performance'[Spend]), SUM('Marketing performance'[Leads (raw)]))",
            "formatString": "\"$\"#,0.00",
            "displayFolder": "Measures"
          },
          {
            "name": "AOV",
            "expression": "DIVIDE(SUM('Marketing performance'[Revenue (raw)]), SUM('Marketing performance'[Conversions (raw)]))",
            "formatString": "\"$\"#,0.00",
            "displayFolder": "Measures"
          },
          {
            "name": "Cost per New Customer",
            "expression": "DIVIDE(SUM('Marketing performance'[Spend]), SUM('Marketing performance'[New Customers (raw)]))",
            "formatString": "\"$\"#,0.00",
            "displayFolder": "Measures"
          },
          {
            "name": "Target ROAS",
            "expression": "3.5",
            "formatString": "#,0.00",
            "displayFolder": "Measures"
          }
        ],
        "partitions": [
          {
            "name": "Marketing performance",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#\"Week\" = _t, #\"Channel\" = _t, #\"Region\" = _t, #\"Channel Group\" = _t, #\"Channel Type\" = _t, #\"Super Region\" = _t, #\"Year\" = _t, #\"Quarter\" = _t, #\"Month\" = _t, #\"Spend\" = _t, #\"Impressions\" = _t, #\"Clicks\" = _t, #\"Conversions\" = _t, #\"Leads\" = _t, #\"Revenue\" = _t, #\"New Customers\" = _t]),",
                "    #\"Typed\" = Table.TransformColumnTypes(Source,{{\"Week\", type date}, {\"Channel\", type text}, {\"Region\", type text}, {\"Channel Group\", type text}, {\"Channel Type\", type text}, {\"Super Region\", type text}, {\"Year\", type text}, {\"Quarter\", type text}, {\"Month\", type text}, {\"Spend\", type number}, {\"Impressions\", Int64.Type}, {\"Clicks\", Int64.Type}, {\"Conversions\", Int64.Type}, {\"Leads\", Int64.Type}, {\"Revenue\", type number}, {\"New Customers\", Int64.Type}},\"en-US\")",
                "in",
                "    #\"Typed\""
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      }
    ],
    "annotations": [
      {
        "name": "PBI_QueryOrder",
        "value": "[\"Marketing performance\"]"
      },
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      }
    ]
  }
}

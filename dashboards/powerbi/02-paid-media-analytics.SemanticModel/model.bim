                "value": "Automatic"
              }
            ]
          },
          {
            "name": "Quarter",
            "dataType": "string",
            "sourceColumn": "Quarter",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "Month",
            "dataType": "string",
            "sourceColumn": "Month",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "Cost",
            "dataType": "double",
            "sourceColumn": "Cost",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "isHidden": true
          },
          {
            "name": "Impressions (raw)",
            "dataType": "int64",
            "sourceColumn": "Impressions",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "isHidden": true
          },
          {
            "name": "Reach (raw)",
            "dataType": "int64",
            "sourceColumn": "Reach",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "isHidden": true
          },
          {
            "name": "Clicks (raw)",
            "dataType": "int64",
            "sourceColumn": "Clicks",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "isHidden": true
          },
          {
            "name": "Conversions (raw)",
            "dataType": "int64",
            "sourceColumn": "Conversions",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "isHidden": true
          },
          {
            "name": "Conversion Value (raw)",
            "dataType": "double",
            "sourceColumn": "Conversion Value",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "isHidden": true
          },
          {
            "name": "Video Views (raw)",
            "dataType": "int64",
            "sourceColumn": "Video Views",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "isHidden": true
          }
        ],
        "measures": [
          {
            "name": "Media Cost",
            "expression": "SUM('Paid media'[Cost])",
            "formatString": "\"$\"#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "Conversion Value",
            "expression": "SUM('Paid media'[Conversion Value (raw)])",
            "formatString": "\"$\"#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "ROAS",
            "expression": "DIVIDE(SUM('Paid media'[Conversion Value (raw)]), SUM('Paid media'[Cost]))",
            "formatString": "#,0.00",
            "displayFolder": "Measures"
          },
          {
            "name": "Impressions",
            "expression": "SUM('Paid media'[Impressions (raw)])",
            "formatString": "#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "Reach",
            "expression": "SUM('Paid media'[Reach (raw)])",
            "formatString": "#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "Clicks",
            "expression": "SUM('Paid media'[Clicks (raw)])",
            "formatString": "#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "Conversions",
            "expression": "SUM('Paid media'[Conversions (raw)])",
            "formatString": "#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "Video Views",
            "expression": "SUM('Paid media'[Video Views (raw)])",
            "formatString": "#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "Active Campaigns",
            "expression": "DISTINCTCOUNT('Paid media'[Campaign])",
            "formatString": "#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "CTR",
            "expression": "DIVIDE(SUM('Paid media'[Clicks (raw)]), SUM('Paid media'[Impressions (raw)]))",
            "formatString": "0.00%",
            "displayFolder": "Measures"
          },
          {
            "name": "CPC",
            "expression": "DIVIDE(SUM('Paid media'[Cost]), SUM('Paid media'[Clicks (raw)]))",
            "formatString": "\"$\"#,0.00",
            "displayFolder": "Measures"
          },
          {
            "name": "CPM",
            "expression": "DIVIDE(SUM('Paid media'[Cost]), SUM('Paid media'[Impressions (raw)])) * 1000",
            "formatString": "\"$\"#,0.00",
            "displayFolder": "Measures"
          },
          {
            "name": "CPA",
            "expression": "DIVIDE(SUM('Paid media'[Cost]), SUM('Paid media'[Conversions (raw)]))",
            "formatString": "\"$\"#,0.00",
            "displayFolder": "Measures"
          },
          {
            "name": "Conversion Rate",
            "expression": "DIVIDE(SUM('Paid media'[Conversions (raw)]), SUM('Paid media'[Clicks (raw)]))",
            "formatString": "0.00%",
            "displayFolder": "Measures"
          },
          {
            "name": "Frequency",
            "expression": "DIVIDE(SUM('Paid media'[Impressions (raw)]), SUM('Paid media'[Reach (raw)]))",
            "formatString": "#,0.00",
            "displayFolder": "Measures"
          },
          {
            "name": "View Rate",
            "expression": "DIVIDE(SUM('Paid media'[Video Views (raw)]), SUM('Paid media'[Impressions (raw)]))",
            "formatString": "0.0%",
            "displayFolder": "Measures"
          },
          {
            "name": "Value per Click",
            "expression": "DIVIDE(SUM('Paid media'[Conversion Value (raw)]), SUM('Paid media'[Clicks (raw)]))",
            "formatString": "\"$\"#,0.00",
            "displayFolder": "Measures"
          },
          {
            "name": "Target ROAS",
            "expression": "3.5",
            "formatString": "#,0.00",
            "displayFolder": "Measures"
          },
          {
            "name": "Target CPA",
            "expression": "45",
            "formatString": "\"$\"#,0",
            "displayFolder": "Measures"
          }
        ],
        "partitions": [
          {
            "name": "Paid media",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#\"Week\" = _t, #\"Campaign\" = _t, #\"Device\" = _t, #\"Platform\" = _t, #\"Objective\" = _t, #\"Funnel Stage\" = _t, #\"Year\" = _t, #\"Quarter\" = _t, #\"Month\" = _t, #\"Cost\" = _t, #\"Impressions\" = _t, #\"Reach\" = _t, #\"Clicks\" = _t, #\"Conversions\" = _t, #\"Conversion Value\" = _t, #\"Video Views\" = _t]),",
                "    #\"Typed\" = Table.TransformColumnTypes(Source,{{\"Week\", type date}, {\"Campaign\", type text}, {\"Device\", type text}, {\"Platform\", type text}, {\"Objective\", type text}, {\"Funnel Stage\", type text}, {\"Year\", type text}, {\"Quarter\", type text}, {\"Month\", type text}, {\"Cost\", type number}, {\"Impressions\", Int64.Type}, {\"Reach\", Int64.Type}, {\"Clicks\", Int64.Type}, {\"Conversions\", Int64.Type}, {\"Conversion Value\", type number}, {\"Video Views\", Int64.Type}},\"en-US\")",
                "in",
                "    #\"Typed\""
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      }
    ],
    "annotations": [
      {
        "name": "PBI_QueryOrder",
        "value": "[\"Paid media\"]"
      },
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      }
    ]
  }
}

        "measures": [
          {
            "name": "Visitors",
            "expression": "SUM('Funnel'[Visitors (raw)])",
            "formatString": "#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "Leads",
            "expression": "SUM('Funnel'[Leads (raw)])",
            "formatString": "#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "MQLs",
            "expression": "SUM('Funnel'[MQLs (raw)])",
            "formatString": "#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "SQLs",
            "expression": "SUM('Funnel'[SQLs (raw)])",
            "formatString": "#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "Opportunities",
            "expression": "SUM('Funnel'[Opportunities (raw)])",
            "formatString": "#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "Customers",
            "expression": "SUM('Funnel'[Customers (raw)])",
            "formatString": "#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "Stage Volume",
            "expression": "SUM('Funnel'[Records])",
            "formatString": "#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "Visitor to Lead %",
            "expression": "DIVIDE(SUM('Funnel'[Leads (raw)]), SUM('Funnel'[Visitors (raw)]))",
            "formatString": "0.00%",
            "displayFolder": "Measures"
          },
          {
            "name": "Lead to MQL %",
            "expression": "DIVIDE(SUM('Funnel'[MQLs (raw)]), SUM('Funnel'[Leads (raw)]))",
            "formatString": "0.0%",
            "displayFolder": "Measures"
          },
          {
            "name": "MQL to SQL %",
            "expression": "DIVIDE(SUM('Funnel'[SQLs (raw)]), SUM('Funnel'[MQLs (raw)]))",
            "formatString": "0.0%",
            "displayFolder": "Measures"
          },
          {
            "name": "SQL to Opportunity %",
            "expression": "DIVIDE(SUM('Funnel'[Opportunities (raw)]), SUM('Funnel'[SQLs (raw)]))",
            "formatString": "0.0%",
            "displayFolder": "Measures"
          },
          {
            "name": "Opportunity to Win %",
            "expression": "DIVIDE(SUM('Funnel'[Customers (raw)]), SUM('Funnel'[Opportunities (raw)]))",
            "formatString": "0.0%",
            "displayFolder": "Measures"
          },
          {
            "name": "End to End Conversion %",
            "expression": "DIVIDE(SUM('Funnel'[Customers (raw)]), SUM('Funnel'[Visitors (raw)]))",
            "formatString": "0.00%",
            "displayFolder": "Measures"
          },
          {
            "name": "Lead to Customer %",
            "expression": "DIVIDE(SUM('Funnel'[Customers (raw)]), SUM('Funnel'[Leads (raw)]))",
            "formatString": "0.0%",
            "displayFolder": "Measures"
          },
          {
            "name": "Pipeline Value",
            "expression": "SUM('Funnel'[Pipeline Value (raw)])",
            "formatString": "\"$\"#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "Won Value",
            "expression": "SUM('Funnel'[Won Value (raw)])",
            "formatString": "\"$\"#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "Avg Deal Size",
            "expression": "DIVIDE(SUM('Funnel'[Won Value (raw)]), SUM('Funnel'[Customers (raw)]))",
            "formatString": "\"$\"#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "Win Rate %",
            "expression": "DIVIDE(SUM('Funnel'[Won Value (raw)]), SUM('Funnel'[Pipeline Value (raw)]))",
            "formatString": "0.0%",
            "displayFolder": "Measures"
          },
          {
            "name": "Avg Sales Cycle Days",
            "expression": "DIVIDE(SUM('Funnel'[Cycle Pool]), SUM('Funnel'[Customers (raw)]))",
            "formatString": "#,0.0",
            "displayFolder": "Measures"
          }
        ],
        "partitions": [
          {
            "name": "Funnel",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#\"Month\" = _t, #\"Source\" = _t, #\"Segment\" = _t, #\"Stage\" = _t, #\"Source Type\" = _t, #\"Stage Order\" = _t, #\"Year\" = _t, #\"Quarter\" = _t, #\"Month Label\" = _t, #\"Cycle Days\" = _t, #\"Records\" = _t, #\"Pipeline Value\" = _t, #\"Won Value\" = _t, #\"Visitors\" = _t, #\"Leads\" = _t, #\"MQLs\" = _t, #\"SQLs\" = _t, #\"Opportunities\" = _t, #\"Customers\" = _t, #\"Cycle Pool\" = _t]),",
                "    #\"Typed\" = Table.TransformColumnTypes(Source,{{\"Month\", type date}, {\"Source\", type text}, {\"Segment\", type text}, {\"Stage\", type text}, {\"Source Type\", type text}, {\"Stage Order\", Int64.Type}, {\"Year\", type text}, {\"Quarter\", type text}, {\"Month Label\", type text}, {\"Cycle Days\", type number}, {\"Records\", Int64.Type}, {\"Pipeline Value\", Int64.Type}, {\"Won Value\", Int64.Type}, {\"Visitors\", Int64.Type}, {\"Leads\", Int64.Type}, {\"MQLs\", Int64.Type}, {\"SQLs\", Int64.Type}, {\"Opportunities\", Int64.Type}, {\"Customers\", Int64.Type}, {\"Cycle Pool\", type number}},\"en-US\")",
                "in",
                "    #\"Typed\""
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      }
    ],
    "annotations": [

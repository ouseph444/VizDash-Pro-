              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "Channel Type",
            "dataType": "string",
            "sourceColumn": "Channel Type",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "Year",
            "dataType": "string",
            "sourceColumn": "Year",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "Quarter",
            "dataType": "string",
            "sourceColumn": "Quarter",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "Month Label",
            "dataType": "string",
            "sourceColumn": "Month Label",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "New Customers (raw)",
            "dataType": "int64",
            "sourceColumn": "New Customers",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "isHidden": true
          },
          {
            "name": "Acquisition Cost",
            "dataType": "double",
            "sourceColumn": "Acquisition Cost",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "isHidden": true
          },
          {
            "name": "New MRR (raw)",
            "dataType": "double",
            "sourceColumn": "New MRR",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "isHidden": true
          },
          {
            "name": "LTV Pool",
            "dataType": "double",
            "sourceColumn": "LTV Pool",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "isHidden": true
          },
          {
            "name": "First Order Revenue (raw)",
            "dataType": "double",
            "sourceColumn": "First Order Revenue",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "isHidden": true
          },
          {
            "name": "Lifetime Pool",
            "dataType": "double",
            "sourceColumn": "Lifetime Pool",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "isHidden": true
          }
        ],
        "measures": [
          {
            "name": "New Customers",
            "expression": "SUM('Acquisition'[New Customers (raw)])",
            "formatString": "#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "Acquisition Spend",
            "expression": "SUM('Acquisition'[Acquisition Cost])",
            "formatString": "\"$\"#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "New MRR",
            "expression": "SUM('Acquisition'[New MRR (raw)])",
            "formatString": "\"$\"#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "First Order Revenue",
            "expression": "SUM('Acquisition'[First Order Revenue (raw)])",
            "formatString": "\"$\"#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "CAC",
            "expression": "DIVIDE(SUM('Acquisition'[Acquisition Cost]), SUM('Acquisition'[New Customers (raw)]))",
            "formatString": "\"$\"#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "ARPU",
            "expression": "DIVIDE(SUM('Acquisition'[New MRR (raw)]), SUM('Acquisition'[New Customers (raw)]))",
            "formatString": "\"$\"#,0.00",
            "displayFolder": "Measures"
          },
          {
            "name": "LTV",
            "expression": "DIVIDE(SUM('Acquisition'[LTV Pool]), SUM('Acquisition'[New Customers (raw)]))",
            "formatString": "\"$\"#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "LTV to CAC",
            "expression": "DIVIDE(SUM('Acquisition'[LTV Pool]), SUM('Acquisition'[Acquisition Cost]))",
            "formatString": "#,0.00",
            "displayFolder": "Measures"
          },
          {
            "name": "CAC Payback Months",
            "expression": "DIVIDE(SUM('Acquisition'[Acquisition Cost]), SUM('Acquisition'[New MRR (raw)]))",
            "formatString": "#,0.0",
            "displayFolder": "Measures"
          },
          {
            "name": "Avg Lifetime Months",
            "expression": "DIVIDE(SUM('Acquisition'[Lifetime Pool]), SUM('Acquisition'[New Customers (raw)]))",
            "formatString": "#,0.0",
            "displayFolder": "Measures"
          },
          {
            "name": "First Order ROI %",
            "expression": "DIVIDE((SUM('Acquisition'[First Order Revenue (raw)]) - SUM('Acquisition'[Acquisition Cost])), SUM('Acquisition'[Acquisition Cost]))",
            "formatString": "0.0%",
            "displayFolder": "Measures"
          },
          {
            "name": "Target LTV to CAC",
            "expression": "3",
            "formatString": "#,0.0",
            "displayFolder": "Measures"
          },
          {
            "name": "Target Payback Months",
            "expression": "12",
            "formatString": "#,0.0",
            "displayFolder": "Measures"
          }
        ],
        "partitions": [
          {
            "name": "Acquisition",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#\"Month\" = _t, #\"Channel\" = _t, #\"Plan\" = _t, #\"Channel Type\" = _t, #\"Year\" = _t, #\"Quarter\" = _t, #\"Month Label\" = _t, #\"New Customers\" = _t, #\"Acquisition Cost\" = _t, #\"New MRR\" = _t, #\"LTV Pool\" = _t, #\"First Order Revenue\" = _t, #\"Lifetime Pool\" = _t]),",
                "    #\"Typed\" = Table.TransformColumnTypes(Source,{{\"Month\", type date}, {\"Channel\", type text}, {\"Plan\", type text}, {\"Channel Type\", type text}, {\"Year\", type text}, {\"Quarter\", type text}, {\"Month Label\", type text}, {\"New Customers\", Int64.Type}, {\"Acquisition Cost\", type number}, {\"New MRR\", type number}, {\"LTV Pool\", type number}, {\"First Order Revenue\", type number}, {\"Lifetime Pool\", type number}},\"en-US\")",
                "in",
                "    #\"Typed\""
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },

        ],
        "measures": [
          {
            "name": "Cohort Customers",
            "expression": "SUM('Cohorts'[Customers Retained])",
            "formatString": "#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "Cohort Starting Size",
            "expression": "SUM('Cohorts'[Cohort Size])",
            "formatString": "#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "Retention %",
            "expression": "DIVIDE(SUM('Cohorts'[Customers Retained]), SUM('Cohorts'[Cohort Size]))",
            "formatString": "0.0%",
            "displayFolder": "Measures"
          },
          {
            "name": "Churn %",
            "expression": "1 - DIVIDE(SUM('Cohorts'[Customers Retained]), SUM('Cohorts'[Cohort Size]))",
            "formatString": "0.0%",
            "displayFolder": "Measures"
          },
          {
            "name": "Cohort Revenue",
            "expression": "SUM('Cohorts'[Cohort Revenue (raw)])",
            "formatString": "\"$\"#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "Revenue per Cohort Customer",
            "expression": "DIVIDE(SUM('Cohorts'[Cohort Revenue (raw)]), SUM('Cohorts'[Cohort Size]))",
            "formatString": "\"$\"#,0.00",
            "displayFolder": "Measures"
          }
        ],
        "partitions": [
          {
            "name": "Cohorts",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#\"Cohort Month\" = _t, #\"Cohort Label\" = _t, #\"Channel\" = _t, #\"Channel Type\" = _t, #\"Month Index\" = _t, #\"Cohort Size\" = _t, #\"Customers Retained\" = _t, #\"Retention\" = _t, #\"Cohort Revenue\" = _t]),",
                "    #\"Typed\" = Table.TransformColumnTypes(Source,{{\"Cohort Month\", type date}, {\"Cohort Label\", type text}, {\"Channel\", type text}, {\"Channel Type\", type text}, {\"Month Index\", Int64.Type}, {\"Cohort Size\", Int64.Type}, {\"Customers Retained\", Int64.Type}, {\"Retention\", type number}, {\"Cohort Revenue\", type number}},\"en-US\")",
                "in",

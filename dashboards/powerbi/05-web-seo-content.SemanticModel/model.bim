        "measures": [
          {
            "name": "Sessions",
            "expression": "SUM('Web analytics'[Sessions (raw)])",
            "formatString": "#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "Users",
            "expression": "SUM('Web analytics'[Users (raw)])",
            "formatString": "#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "New Users",
            "expression": "SUM('Web analytics'[New Users (raw)])",
            "formatString": "#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "Pageviews",
            "expression": "SUM('Web analytics'[Pageviews (raw)])",
            "formatString": "#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "Goal Completions",
            "expression": "SUM('Web analytics'[Goal Completions (raw)])",
            "formatString": "#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "Goal Value",
            "expression": "SUM('Web analytics'[Goal Value (raw)])",
            "formatString": "\"$\"#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "Bounce Rate",
            "expression": "DIVIDE(SUM('Web analytics'[Bounces]), SUM('Web analytics'[Sessions (raw)]))",
            "formatString": "0.0%",
            "displayFolder": "Measures"
          },
          {
            "name": "Engagement Rate",
            "expression": "1 - DIVIDE(SUM('Web analytics'[Bounces]), SUM('Web analytics'[Sessions (raw)]))",
            "formatString": "0.0%",
            "displayFolder": "Measures"
          },
          {
            "name": "Pages per Session",
            "expression": "DIVIDE(SUM('Web analytics'[Pageviews (raw)]), SUM('Web analytics'[Sessions (raw)]))",
            "formatString": "#,0.00",
            "displayFolder": "Measures"
          },
          {
            "name": "Avg Session Duration",
            "expression": "DIVIDE(SUM('Web analytics'[Session Seconds]), SUM('Web analytics'[Sessions (raw)]))",
            "formatString": "#,0.0",
            "displayFolder": "Measures"
          },
          {
            "name": "New User %",
            "expression": "DIVIDE(SUM('Web analytics'[New Users (raw)]), SUM('Web analytics'[Users (raw)]))",
            "formatString": "0.0%",
            "displayFolder": "Measures"
          },
          {
            "name": "Sessions per User",
            "expression": "DIVIDE(SUM('Web analytics'[Sessions (raw)]), SUM('Web analytics'[Users (raw)]))",
            "formatString": "#,0.00",
            "displayFolder": "Measures"
          },
          {
            "name": "Goal Conversion Rate",
            "expression": "DIVIDE(SUM('Web analytics'[Goal Completions (raw)]), SUM('Web analytics'[Sessions (raw)]))",
            "formatString": "0.00%",
            "displayFolder": "Measures"
          },
          {
            "name": "Value per Session",
            "expression": "DIVIDE(SUM('Web analytics'[Goal Value (raw)]), SUM('Web analytics'[Sessions (raw)]))",
            "formatString": "\"$\"#,0.00",
            "displayFolder": "Measures"
          },
          {
            "name": "Value per User",
            "expression": "DIVIDE(SUM('Web analytics'[Goal Value (raw)]), SUM('Web analytics'[Users (raw)]))",
            "formatString": "\"$\"#,0.00",
            "displayFolder": "Measures"
          }
        ],
        "partitions": [
          {
            "name": "Web analytics",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#\"Month\" = _t, #\"Channel\" = _t, #\"Device\" = _t, #\"Country\" = _t, #\"Year\" = _t, #\"Quarter\" = _t, #\"Month Label\" = _t, #\"Sessions\" = _t, #\"Users\" = _t, #\"New Users\" = _t, #\"Pageviews\" = _t, #\"Bounces\" = _t, #\"Session Seconds\" = _t, #\"Goal Completions\" = _t, #\"Goal Value\" = _t]),",
                "    #\"Typed\" = Table.TransformColumnTypes(Source,{{\"Month\", type date}, {\"Channel\", type text}, {\"Device\", type text}, {\"Country\", type text}, {\"Year\", type text}, {\"Quarter\", type text}, {\"Month Label\", type text}, {\"Sessions\", Int64.Type}, {\"Users\", Int64.Type}, {\"New Users\", Int64.Type}, {\"Pageviews\", Int64.Type}, {\"Bounces\", Int64.Type}, {\"Session Seconds\", Int64.Type}, {\"Goal Completions\", Int64.Type}, {\"Goal Value\", type number}},\"en-US\")",
                "in",
                "    #\"Typed\""
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"

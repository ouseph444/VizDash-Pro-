        "measures": [
          {
            "name": "Impressions",
            "expression": "SUM('Social'[Impressions (raw)])",
            "formatString": "#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "Reach",
            "expression": "SUM('Social'[Reach (raw)])",
            "formatString": "#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "Engagements",
            "expression": "SUM('Social'[Engagements (raw)])",
            "formatString": "#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "Posts",
            "expression": "SUM('Social'[Posts (raw)])",
            "formatString": "#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "Likes",
            "expression": "SUM('Social'[Likes (raw)])",
            "formatString": "#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "Comments",
            "expression": "SUM('Social'[Comments (raw)])",
            "formatString": "#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "Shares",
            "expression": "SUM('Social'[Shares (raw)])",
            "formatString": "#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "Saves",
            "expression": "SUM('Social'[Saves (raw)])",
            "formatString": "#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "Link Clicks",
            "expression": "SUM('Social'[Link Clicks (raw)])",
            "formatString": "#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "Video Views",
            "expression": "SUM('Social'[Video Views (raw)])",
            "formatString": "#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "Mentions",
            "expression": "SUM('Social'[Mentions (raw)])",
            "formatString": "#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "Engagement Rate",
            "expression": "DIVIDE(SUM('Social'[Engagements (raw)]), SUM('Social'[Reach (raw)]))",
            "formatString": "0.00%",
            "displayFolder": "Measures"
          },
          {
            "name": "Engagements per Post",
            "expression": "DIVIDE(SUM('Social'[Engagements (raw)]), SUM('Social'[Posts (raw)]))",
            "formatString": "#,0.0",
            "displayFolder": "Measures"
          },
          {
            "name": "Amplification Rate",
            "expression": "DIVIDE(SUM('Social'[Shares (raw)]), SUM('Social'[Reach (raw)]))",
            "formatString": "0.00%",
            "displayFolder": "Measures"
          },
          {
            "name": "Conversation Rate",
            "expression": "DIVIDE(SUM('Social'[Comments (raw)]), SUM('Social'[Reach (raw)]))",
            "formatString": "0.00%",
            "displayFolder": "Measures"
          },
          {
            "name": "Save Rate",
            "expression": "DIVIDE(SUM('Social'[Saves (raw)]), SUM('Social'[Reach (raw)]))",
            "formatString": "0.00%",
            "displayFolder": "Measures"
          },
          {
            "name": "Click Through Rate",
            "expression": "DIVIDE(SUM('Social'[Link Clicks (raw)]), SUM('Social'[Impressions (raw)]))",
            "formatString": "0.00%",
            "displayFolder": "Measures"
          },
          {
            "name": "View Rate",
            "expression": "DIVIDE(SUM('Social'[Video Views (raw)]), SUM('Social'[Impressions (raw)]))",
            "formatString": "0.0%",
            "displayFolder": "Measures"
          },
          {
            "name": "Frequency",
            "expression": "DIVIDE(SUM('Social'[Impressions (raw)]), SUM('Social'[Reach (raw)]))",
            "formatString": "#,0.00",
            "displayFolder": "Measures"
          },
          {
            "name": "Followers Gained",
            "expression": "SUM('Social'[Followers Gained (raw)])",
            "formatString": "#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "Followers Lost",
            "expression": "SUM('Social'[Followers Lost (raw)])",
            "formatString": "#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "Net Follower Growth",
            "expression": "SUM('Social'[Followers Gained (raw)]) - SUM('Social'[Followers Lost (raw)])",
            "formatString": "#,0",
            "displayFolder": "Measures"
          },
          {
            "name": "Avg Sentiment",
            "expression": "DIVIDE(SUM('Social'[Sentiment Pool]), SUM('Social'[Mentions (raw)]))",
            "formatString": "#,0.00",
            "displayFolder": "Measures"
          },
          {
            "name": "Target Engagement Rate",
            "expression": "0.035",
            "formatString": "0.0%",
            "displayFolder": "Measures"
          }
        ],
        "partitions": [
          {
            "name": "Social",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#\"Week\" = _t, #\"Platform\" = _t, #\"Post Type\" = _t, #\"Platform Group\" = _t, #\"Format Group\" = _t, #\"Year\" = _t, #\"Quarter\" = _t, #\"Month\" = _t, #\"Posts\" = _t, #\"Impressions\" = _t, #\"Reach\" = _t, #\"Engagements\" = _t, #\"Likes\" = _t, #\"Comments\" = _t, #\"Shares\" = _t, #\"Saves\" = _t, #\"Link Clicks\" = _t, #\"Followers Gained\" = _t, #\"Followers Lost\" = _t, #\"Video Views\" = _t, #\"Mentions\" = _t, #\"Sentiment Pool\" = _t]),",
                "    #\"Typed\" = Table.TransformColumnTypes(Source,{{\"Week\", type date}, {\"Platform\", type text}, {\"Post Type\", type text}, {\"Platform Group\", type text}, {\"Format Group\", type text}, {\"Year\", type text}, {\"Quarter\", type text}, {\"Month\", type text}, {\"Posts\", Int64.Type}, {\"Impressions\", Int64.Type}, {\"Reach\", Int64.Type}, {\"Engagements\", Int64.Type}, {\"Likes\", Int64.Type}, {\"Comments\", Int64.Type}, {\"Shares\", Int64.Type}, {\"Saves\", Int64.Type}, {\"Link Clicks\", Int64.Type}, {\"Followers Gained\", Int64.Type}, {\"Followers Lost\", Int64.Type}, {\"Video Views\", Int64.Type}, {\"Mentions\", Int64.Type}, {\"Sentiment Pool\", type number}},\"en-US\")",
                "in",
                "    #\"Typed\""
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]

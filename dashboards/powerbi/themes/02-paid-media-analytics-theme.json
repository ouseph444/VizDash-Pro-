{
  "name": "Paid Media & Campaign Analytics",
  "dataColors": [
    "#7c4dff",
    "#ff3d9a",
    "#00c2ff",
    "#ffb020",
    "#22c55e",
    "#f43f5e",
    "#9b6bff",
    "#00d4b4"
  ],
  "background": "#ffffff",
  "backgroundLight": "#f2effa",
  "backgroundNeutral": "#e2dcf2",
  "foreground": "#241454",
  "foregroundNeutralSecondary": "#6b5f8c",
  "tableAccent": "#7c4dff",
  "good": "#22c55e",
  "neutral": "#8c8c8c",
  "bad": "#f43f5e",
  "textClasses": {
    "title": {
      "fontSize": 13,
      "fontFace": "Segoe UI Semibold",
      "color": "#241454"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#6b5f8c"
    },
    "callout": {
      "fontSize": 24,
      "fontFace": "Segoe UI",
      "color": "#241454"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#ffffff"
              }
            }
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#e2dcf2"
              }
            },
            "radius": 8
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#241454"
              }
            },
            "fontSize": 11,
            "bold": true,
            "alignment": "left"
          }
        ]
      }
    }
  }
}